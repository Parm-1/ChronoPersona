+    if not isinstance(conditions, list) or not all(
+        isinstance(condition, str) for condition in conditions
+    ):
+        raise SyntheticCalibrationError("conditions must be a string list")
+    if tuple(conditions) != CONDITIONS:
         raise SyntheticCalibrationError("conditions must match the frozen v0 order")
     count = config.get("document_count_per_condition_domain")
     if count != 16:
