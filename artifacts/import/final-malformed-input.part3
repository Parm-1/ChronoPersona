+from chronopersona.synthetic_calibration import (
+    SyntheticCalibrationError,
+    build_dose_plan,
+    build_package,
+    generate_documents,
+    validate_dose_plan,
+)
+
+
+ROOT - Path(__file__).resolve().parents[1]
+CONTENT_MANIFEST - (
+    ROOT / "tests" / "fixtures" / "content-integrity" / "manifest.jsonl"
+)
+CALIBRATION_CONFIG - ROOT / "configs" / "calibration" / "synthetic-v0.json"
+
+
+def _calibration_config() -> dict:
+    return json.loads(CALIBRATION_CONFIG.read_text(encoding="utf-8"))
+
+
+def _build_package_from_value(config: dict) -> None:
+    with TemporaryDirectory() as directory:
+        path = Path(directory) / "config.json"
+        path.write_text(json.dumps(config), encoding="utf-8")
+        build_package(path)
+
+
+@pytest.mark.parametrize("value", ["a/delete\x7f.json", "a/next-line\u0085.json"])
+def test_delete_and_c1_controls_are_rejected(value: str) -> None:
+    with pytest.raises(PortablePathError, match="control characters"):
+        portable_relative_path(value)
+
+
+def test_holdout_authorization_scope_rejects_non_string_values() -> None:
+    records = list(load_content_manifest(CONTENT_MANIFEST))
+    index = next(
+        index
+        for index, record in enumerate(records)
+        if record["source_family"] == "C"
+    )
+    records[index] = {
+        **records[index],
+        "synthetic_fixture": False,
+        "authorship_provenance": "human",
+    }
+    authorization = {
+        "schema_version": 1,
+        "purpose": "pre-confirmatory-content-integrity-audit",
+        "source_family": "C",
+        "manifest_sha256": "a" * 64,
+        "scope": [
+            {"unexpected": "object"},
+            "near-duplicate",
+            "evaluation-exposure",
+            "direct-exposure",
+        ],
+        "authorized_by": "fixture-reviewer",
+        "authorized_at": "2026-08-18T00:00:00Z",
+        "no_behavioral_outcomes_inspected": True,
+    }
+
+    assert validate_holdout_authorization(
+        records,
+        manifest_sha256="a" * 64,
+        authorization=authorization,
+    ) == (
+        "holdout authorization scope must match the v0 audit scope",
+    )
+
+
+@pytest.mark.parametrize(
+    ("mutator", "message"),
+    [
+        (
+            lambda config: config.__setitem__("conditions", 1),
+            "conditions must be a string list",
+        ),
+        (
+            lambda config: config["policy_pairs"][0].__setitem__(
+                "reference_pole", {"unexpected": "object"}
+            ),
+            "pole orientation is invalid",
+        ),
+        (
+            lambda config: config["policy_pairs"][0]["training_domains"][0][
+                "entities"
+            ].__setitem__(0, {"unexpected": "object"}),
+            "entities must contain nonempty strings",
+        ),
+        (
+            lambda config: config["policy_pairs"][0]["heldout_domain"][
+                "entities"
+            ].__setitem__(0, {"unexpected": "object"}),
+            "entities must contain nonempty strings",
+        ),
+    ],
+)
+def test_malformed_calibration_config_arrays_fail_closed(
+    mutator,
+    message: str,
+) -> None:
+    config = _calibration_config()
+    mutator(config)
+
+    with pytest.raises(SyntheticCalibrationError, match=message):
+        _build_package_from_value(config)
+
+
+def test_dose_plan_rejects_non_object_branches() -> None:
+    config = _calibration_config()
+    _, metadata = generate_documents(config)
+    plan = build_dose_plan(config, metadata)
+    plan["branches"][0] = []
+
+    assert "branches[0] must be an object" in validate_dose_plan(plan)
+
+
+def test_dose_plan_rejects_non_string_document_ids() -> None:
+    config = _calibration_config()
+    _, metadata = generate_documents(config)
+    plan = build_dose_plan(config, metadata)
+    plan["branches"][0]["document_ids"][0] = {"unexpected": "object"}
+
+    assert (
+        "branches[0].document_ids must be a list of nonempty strings"